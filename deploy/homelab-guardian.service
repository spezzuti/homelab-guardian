# Example systemd user service for a continuously running Guardian.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/homelab-guardian.service ~/.config/systemd/user/
#   # Edit WorkingDirectory and the venv path below for your checkout.
#   systemctl --user daemon-reload
#   systemctl --user enable --now homelab-guardian
#   journalctl --user -u homelab-guardian -f
#
# To survive logout, enable lingering once: loginctl enable-linger $USER
#
# Secrets: put token environment variables in an EnvironmentFile that is
# readable only by your user (chmod 600), or wrap ExecStart with a secrets
# injector such as `bws run --`. Never bake tokens into this unit file.

[Unit]
Description=Homelab Guardian recurring health scans
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/homelab-guardian
Environment=PYTHONUNBUFFERED=1
# EnvironmentFile=%h/homelab-guardian/.env
ExecStart=%h/homelab-guardian/.venv/bin/python -m app.main --config config.yaml --interval 900
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
